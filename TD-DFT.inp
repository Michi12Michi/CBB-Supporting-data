!&EXT_RESTART
! RESTART_FILE_NAME ./pol1-triplet-1.restart
!&END EXT_RESTART
&FORCE_EVAL
  METHOD         Quickstep
!  STRESS_TENSOR  ANALYTICAL
!  &PRINT
!    &STRESS_TENSOR
!    &END STRESS_TENSOR
!  &END PRINT
&PROPERTIES
      &TDDFPT                          ! input section for TDDFPT
 !      KERNEL FULL                       ! specification of the underlying kernel matrix K
                                         ! FULL kernel is for GGA and hybrid functional computations
                                         ! sTDA kernel is referring to a semi-empirical sTDA computation
       NSTATES 30                      ! specifies the number of excited states to be computed
       MAX_ITER   100                  ! number of iterations for the Davidson algorithm
       CONVERGENCE [eV] 1.0e-4         ! convergence threshold in eV
       RKS_TRIPLETS F
       RESTART
       WFN_RESTART_FILE_NAME ./pol1-triplet-RESTART.tdwfn
     !  RES_ETYPE  S                 ! Keyword to choose between singlet and triplet excitations
     !  &MGRID                         ! It is also possible to choose a separate grid for the real-space
     !    CUTOFF 600                   ! integration of the response density in the TDDFT part,
     !    REL_CUTOFF 60                ! however, in general a consistent setup for GS and ES is recommended
     !  &END MGRID
      &END TDDFPT
    &END PROPERTIES
  &DFT
            BASIS_SET_FILE_NAME /g100_work/IscrC_MHP-DEF/BASIS/BASIS_MOLOPT.txt
            POTENTIAL_FILE_NAME /g100_work/IscrC_MHP-DEF/BASIS/GTH_POTENTIALS.txt
            BASIS_SET_FILE_NAME /g100_work/IscrC_MHP-DEF/BASIS/BASIS_ADMM_MOLOPT.txt
            BASIS_SET_FILE_NAME /g100_work/IscrC_MHP-DEF/BASIS/BASIS_ADMM.txt
            WFN_RESTART_FILE_NAME ./pol1-triplet-RESTART.wfn
!   CHARGE -1
!    MULTIPLICITY 3
!    UKS T
    &MGRID
      CUTOFF       600
      REL_CUTOFF    50
    &END MGRID
    &QS
    &END QS
    &SCF
      SCF_GUESS  RESTART
      MAX_SCF    50
      &OT
        MINIMIZER       CG
        PRECONDITIONER  FULL_SINGLE_INVERSE
      &END
      &OUTER_SCF
        MAX_SCF  50
      &END
!      &PRINT
!        &RESTART OFF
!        &END
!      &END
    &END SCF
    &AUXILIARY_DENSITY_MATRIX_METHOD
        METHOD BASIS_PROJECTION
        ADMM_PURIFICATION_METHOD NONE
     &END AUXILIARY_DENSITY_MATRIX_METHOD
    &PRINT
!       &MO LOW
!          EIGENVALUES
!          &EACH
!              QS_SCF 0
!          &END EACH
!       &END MO
       &MO_CUBES
        NHOMO 1
       NLUMO 1
        WRITE_CUBE
!         &EACH
!          MD 50
!         &END EACH
      &END MO_CUBES
!       &TOT_DENSITY_CUBE
!       &END
    &END PRINT
&XC
    2ND_DERIV_ANALYTICAL F
 &XC_FUNCTIONAL
  &PBE
!   PARAMETRIZATION REVPBE
   SCALE_X 0.69
   SCALE_C 1.0
 &END PBE
 &PBE_HOLE_T_C_LR
 CUTOFF_RADIUS 7.9
 SCALE_X 0.31
 &END PBE_HOLE_T_C_LR
&END XC_FUNCTIONAL
&HF
&SCREENING
EPS_SCHWARZ 1.0E-6
SCREEN_ON_INITIAL_P FALSE
&END SCREENING
&INTERACTION_POTENTIAL
POTENTIAL_TYPE TRUNCATED
CUTOFF_RADIUS 7.9
T_C_G_DATA  /g100_work/IscrC_MHP-DEF/t_c_g.dat
&END INTERACTION_POTENTIAL
&MEMORY
MAX_MEMORY 3600
EPS_STORAGE_SCALING 0.1
&END MEMORY
FRACTION 0.31
&END HF
      ! non-local vdW part
      &vdW_POTENTIAL
         DISPERSION_FUNCTIONAL NON_LOCAL
         &NON_LOCAL
           TYPE RVV10
           PARAMETERS  6.3  0.0093
           KERNEL_FILE_NAME   /g100_work/IscrC_MHP-DEF/rVV10_kernel_table.dat
           CUTOFF      400
         &END NON_LOCAL
      &END vdW_POTENTIAL
    &END XC
  &END DFT
  &SUBSYS
    &CELL
      ABC  15.944 27.616 19.734
    &END CELL
    &TOPOLOGY
      COORD_FILE_NAME  ./test.xyz
      COORD_FILE_FORMAT xyz
    &END TOPOLOGY
    &KIND Pb
      BASIS_SET DZVP-MOLOPT-SR-GTH-q4
      POTENTIAL GTH-PBE-q4
    &END KIND
    &KIND Br
      BASIS_SET DZVP-MOLOPT-SR-GTH-q7
      BASIS_SET AUX_FIT cFIT6 !SZV-MOLOPT-SR-GTH
      POTENTIAL GTH-PBE-q7
    &END KIND
    &KIND O
      BASIS_SET DZVP-MOLOPT-GTH-q6
      POTENTIAL GTH-PBE-q6
    &END KIND
    &KIND H
      BASIS_SET DZVP-MOLOPT-SR-GTH-q1
      POTENTIAL GTH-PBE-q1
    &END KIND
    &KIND C
      BASIS_SET DZVP-MOLOPT-GTH-q4
      POTENTIAL GTH-PBE-q4
!      BASIS_SET AUX_FIT cFIT3 !SZV-MOLOPT-SR-GTH
    &END KIND
    &KIND N
      BASIS_SET DZVP-MOLOPT-GTH-q5
      POTENTIAL GTH-PBE-q5
!      BASIS_SET AUX_FIT cFIT3 !SZV-MOLOPT-SR-GTH
    &END KIND
    &KIND Sn
      BASIS_SET DZVP-MOLOPT-SR-GTH-q4
      POTENTIAL GTH-PBE-q4
!      BASIS_SET AUX_FIT cFIT6 !SZV-MOLOPT-SR-GTH
    &END KIND
    &KIND Bi
      BASIS_SET         DZVP-MOLOPT-SR-GTH-q5
      BASIS_SET AUX_FIT cFIT6
      POTENTIAL         GTH-PBE-q5
    &END KIND
    &KIND Cs
      BASIS_SET DZVP-MOLOPT-SR-GTH-q9
      BASIS_SET AUX_FIT cFIT7 !SZV-MOLOPT-SR-GTH
      POTENTIAL GTH-PBE-q9
    &END KIND
  &END SUBSYS
&END FORCE_EVAL
&MOTION
   &CONSTRAINT
   &FIXED_ATOMS
   LIST 1
   LIST 3 4
   LIST 7 11 12
   LIST 14..31
   LIST 33
   LIST 36..39
   LIST 41..45
   LIST 47..57
   LIST 59..84
   LIST 88
   LIST 92..95
   LIST 97..166
   LIST 169..212
   LIST 214..218
   LIST 221 222
 &END FIXED_ATOMS
 &END CONSTRAINT
 &GEO_OPT
  OPTIMIZER BFGS
    &BFGS
     TRUST_RADIUS 0.1
    &END
 &END GEO_OPT
  &END MOTION
&GLOBAL
  PROJECT      pol1-triplet
  RUN_TYPE     WFN_OPT
  PRINT_LEVEL  LOW
&END GLOBAL
